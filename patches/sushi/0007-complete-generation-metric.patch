+++ b/src/decode_metric_boundary.zig
@@ -0,0 +1,79 @@
+const std = @import("std");
+/// Immutable reporting boundary. No controller/tick counters are changed.
+/// Time: prefill-end -> terminal decision after publishing the final counted token.
+/// Numerator: all published completion tokens (existing throughput convention),
+/// excluding un-emitted EOS and discarded suffix. First token may be produced by
+/// prefill; decode_tokens exposes the distinct post-prefill count.
+pub const Boundary = struct {
+    begin_ns: ?u64 = null,
+    end_ns: ?u64 = null,
+    prefill_tokens: u32 = 0,
+    published_tokens: u32 = 0,
+    pub fn begin(self: *Boundary, now: u64, published: u32) void {
+        if (self.begin_ns != null or self.end_ns != null) return;
+        self.begin_ns = now; self.prefill_tokens = published;
+    }
+    pub fn finish(self: *Boundary, now: u64, published: u32) void {
+        if (self.end_ns != null) return;
+        if (self.begin_ns == null) { self.begin_ns = now; self.prefill_tokens = published; }
+        self.end_ns = now; self.published_tokens = published;
+    }
+    pub fn elapsed(self: Boundary) ?u64 {
+        const end = self.end_ns orelse return null;
+        return end -| self.begin_ns.?;
+    }
+    pub fn decodeTokens(self: Boundary) u32 { return self.published_tokens -| self.prefill_tokens; }
+    pub fn reportedNs(self: Boundary, legacy_tick_ns: u64) u64 { return self.elapsed() orelse legacy_tick_ns; }
+};
+test "terminal length includes last round even when tick charge is late" {
+    var b: Boundary = .{}; b.begin(100,1);
+    // Ninety-three completed rounds charged 3290; the last round costs 37.
+    b.finish(3427,256);
+    try std.testing.expectEqual(@as(u64,3327),b.reportedNs(3290));
+    try std.testing.expectEqual(@as(u32,256),b.published_tokens);
+    try std.testing.expectEqual(@as(u32,255),b.decodeTokens());
+    // A delayed outer charge and post-generation logging cannot change it.
+    try std.testing.expectEqual(@as(u64,3327),b.reportedNs(9000));
+    b.finish(10000,999); b.begin(20000,999);
+    try std.testing.expectEqual(@as(u64,3327),b.reportedNs(15000));
+    try std.testing.expectEqual(@as(u32,256),b.published_tokens);
+}
+test "terminal EOS counts only published prefix, not EOS or speculative suffix" {
+    var b: Boundary = .{}; b.begin(10,1);
+    const proposed = [_]u32{11,12,99,13,14}; var published:u32=1;
+    for(proposed) |token| { if(token==99) break; published+=1; }
+    b.finish(60,published);
+    try std.testing.expectEqual(@as(u32,3),b.published_tokens);
+    try std.testing.expectEqual(@as(u32,2),b.decodeTokens());
+    try std.testing.expectEqual(@as(u64,50),b.reportedNs(30));
+}
+test "one token length stop during prefill has zero decode duration" {
+    var b: Boundary = .{}; b.finish(30,1); b.begin(40,1);
+    try std.testing.expectEqual(@as(u64,0),b.reportedNs(500));
+    try std.testing.expectEqual(@as(u32,1),b.published_tokens);
+    try std.testing.expectEqual(@as(u32,0),b.decodeTokens());
+}
+test "EOS before first published token has no invented completion" {
+    var b: Boundary = .{}; b.finish(30,0);
+    try std.testing.expectEqual(@as(u32,0),b.published_tokens);
+    try std.testing.expectEqual(@as(u32,0),b.decodeTokens());
+    try std.testing.expectEqual(@as(u64,0),b.reportedNs(100));
+}
+test "length stop at two tokens counts final token once" {
+    var b: Boundary = .{}; b.begin(20,1); b.finish(45,2);
+    try std.testing.expectEqual(@as(u32,2),b.published_tokens);
+    try std.testing.expectEqual(@as(u32,1),b.decodeTokens());
+    try std.testing.expectEqual(@as(u64,25),b.reportedNs(0));
+}
+test "block length clip ignores internally accepted suffix" {
+    var b: Boundary = .{}; b.begin(20,1);
+    const block=[_]u32{2,3,4,5};var published:u32=1;
+    for(block) |_| {published+=1;if(published==3)break;}
+    b.finish(55,published);
+    try std.testing.expectEqual(@as(u32,3),b.published_tokens);
+    try std.testing.expectEqual(@as(u32,2),b.decodeTokens());
+}
+test "uncompleted report uses previous tick scope without claiming final boundary" {
+    const b:Boundary=.{};try std.testing.expect(b.elapsed()==null);
+    try std.testing.expectEqual(@as(u64,123),b.reportedNs(123));
+}
